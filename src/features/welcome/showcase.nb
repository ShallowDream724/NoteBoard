@block {"type":"mathBlock","attrs":{"textColor":null,"background":null,"concealed":false,"annotationId":null,"latex":"\\mathcal{L}(\\theta)=\\frac{1}{n}\\sum_{i=1}^{n}\\left(y_i-f_{\\theta}(x_i)\\right)^2+\\lambda\\lVert\\theta\\rVert_2^2","delimiter":"\\["}}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"矩阵也可以保留自己的行距："}]}
@block {"type":"mathBlock","attrs":{"textColor":null,"background":null,"concealed":false,"annotationId":null,"latex":"A=\\begin{pmatrix}\n1 & 2 \\\\[2pt]\n3 & 4\n\\end{pmatrix},\\qquad \\det A=-2","delimiter":"\\["}}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"支持 "},{"type":"text","marks":[{"type":"code"}],"text":"$…$"},{"type":"text","text":"、"},{"type":"text","marks":[{"type":"code"}],"text":"$$…$$"},{"type":"text","text":"、"},{"type":"text","marks":[{"type":"code"}],"text":"\\(…\\)"},{"type":"text","text":" 和 "},{"type":"text","marks":[{"type":"code"}],"text":"\\[…\\]"},{"type":"text","text":"。公式有语法错误时，源码会保留下来，方便继续修正。"}]}
