#!noteboard 1
@block {"type":"annotationStore"}
@child {"type":"annotationBody","attrs":{"id":"showcase-observation"},"content":[{"type":"paragraph","content":[{"type":"text","text":"同一处景色，在不同时间会呈现不同的光线、颜色与情绪。试着用这三张图做一份观察手记："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"晨光：记录第一眼看到的轮廓和方向。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"林间：补充环境、声音和途中发现。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"暮色：回顾哪些细节改变了最初的判断。"}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"你可以直接改写这份说明，也可以在其中添加列表、图片或更完整的资料。说明与正文一起保存在这份文档里。"}]}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":1},"content":[{"type":"text","text":"欢迎使用 NoteBoard"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"把想法写下来，把关系画出来。"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"这是一份可以直接编辑的 NoteBoard 原生文档。试着切换图片、点开文字说明，或者修改公式。按 "},{"type":"text","text":"Ctrl+S","marks":[{"type":"bold"}]},{"type":"text","text":"，就能把自己的版本保存到本地。"}]}
@block {"type":"githubAlert","attrs":{"concealed":false,"annotationId":null,"kind":"tip"},"content":[{"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"不知道从哪里开始？先选中这句话，试试加粗、下划线和配色。彩色 A 会记住上次的文字颜色与高亮；停留在右侧箭头上，即可展开色板。"}]}]}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"先试试：把一段旅程放进文档"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"从顶部工具栏的图片菜单，可以插入单张图片、四宫格、六宫格、九宫格或图片轮播。下面的四宫格留了一格给你，点击空格即可加入自己的图片。图注也可以直接修改。"}]}
@block {"type":"imageCollection","attrs":{"layout":"grid","columns":2}}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"data:image/png;base64,","alt":"晨光中的山峰与湖面"}},{"type":"paragraph","content":[{"type":"text","text":"01 / 晨光 · 在湖边开始记录"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"data:image/png;base64,","alt":"绿林环抱的山间湖泊"}},{"type":"paragraph","content":[{"type":"text","text":"02 / 林间 · 留下沿途的发现"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"data:image/png;base64,","alt":"夕阳下的群山与飞鸟"}},{"type":"paragraph","content":[{"type":"text","text":"03 / 暮色 · 回看一天的变化"}]}]}
@child {"type":"imageSlot"}
@block {"type":"paragraph","content":[{"type":"text","text":"需要更多对照时，六宫格适合两组各三张图片，九宫格适合一整组观察。把光照、构图或过程放在同一页，更容易看出差异。"}]}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"轮播，让故事一张张展开"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"点击下方的左右箭头或圆点，依次查看晨光、林间和暮色。轮播适合步骤演示、旅行记录和作品展示。"}]}
@block {"type":"imageCollection","attrs":{"layout":"carousel","columns":2}}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"data:image/png;base64,","alt":"旅程第一幕：晨光山湖"}},{"type":"paragraph","content":[{"type":"text","text":"第一幕 / 出发，记下最初的印象"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"data:image/png;base64,","alt":"旅程第二幕：林间湖泊"}},{"type":"paragraph","content":[{"type":"text","text":"第二幕 / 停留，寻找值得细看的变化"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"data:image/png;base64,","alt":"旅程第三幕：山间暮色"}},{"type":"paragraph","content":[{"type":"text","text":"第三幕 / 回望，把发现连成自己的故事"}]}]}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"把补充说明留在文字身边"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"试着点击这段"},{"type":"text","text":"带说明的文字","marks":[{"type":"annotationReference","attrs":{"id":"showcase-observation"}}]},{"type":"text","text":"，查看补充内容。也可以选中任意一段文字，在浮动工具栏中点击“添加说明”，写下背景、出处或下一步想法。"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"说明跟着正文中的锚点保存。把较长的解释收进说明里，阅读时就能沿着主线继续，也随时可以回头细看。"}]}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"展开细节，或者暂时藏起答案"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"点击“旅程记录清单”展开下面的折叠块。收起后，详细内容仍会随文档保留。"}]}
@block {"type":"disclosure","attrs":{"title":"旅程记录清单","open":false},"content":[{"type":"paragraph","content":[{"type":"text","text":"一次简单的记录，可以从这三件事开始："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"给每张图片写一句简短图注。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"记下当时的时间、天气和观察位置。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"把不确定的问题留在说明里，下次继续验证。"}]}]}]}]}
@block {"type":"paragraph","content":[{"type":"text","text":"给自己留一个小提示："},{"type":"text","text":"最值得保存的，往往是当时注意到的细节。","marks":[{"type":"conceal"}]},{"type":"text","text":" 把鼠标移到模糊文字上，或用键盘聚焦，就能读到它。"}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":2},"content":[{"type":"text","text":"写作，不必来回切换工具"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"普通段落、"},{"type":"text","text":"重点","marks":[{"type":"bold"}]},{"type":"text","text":"、"},{"type":"text","text":"强调","marks":[{"type":"italic"}]},{"type":"text","text":"、"},{"type":"text","text":"删改","marks":[{"type":"strike"}]},{"type":"text","text":"、"},{"type":"text","text":"下划线","marks":[{"type":"underline"}]},{"type":"text","text":"，以及值得回看的句子，都能放在同一份文档中。原生文档会保存文字样式、图片布局与补充说明；Markdown 文件也可以在正文与源码之间切换。"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"文字颜色与高亮可以叠加。选好一组配色，下次点击 A 就能一起应用；高亮色板的第一格是透明，重置则清除两种颜色。段落也可以居中、居右或调整缩进。"}]}
@block {"type":"bulletList","attrs":{"annotationId":null}}
