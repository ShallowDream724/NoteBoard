@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"把鼠标移到表格外沿，用小把手选中整行、整列或整张表。选区可以填底色、调整水平与垂直对齐，也可以合并单元格；选中合并过的格子时，“拆分”才会启用。首行和首列可以设为表头。"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"表格的列宽、行高可以拖动调整，也能一键均分列宽。标准表可以填色，三线表保留简洁的线条。导出 PDF 时，超宽表格和公式可以单独调整排版，其他内容保持原样。"}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":2},"content":[{"type":"text","text":"提示块，让重点有层次"}]}
