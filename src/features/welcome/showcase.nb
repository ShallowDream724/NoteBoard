@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"这些是默认按键。在设置的“快捷键”页可以搜索命令、录入新组合、禁用或恢复默认。遇到截图软件等程序占用按键时，检测结果会提示冲突，换一组顺手的组合即可。"}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":2},"content":[{"type":"text","text":"调成自己舒服的样子"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"晨光、琥珀、墨夜，或者跟随系统。界面、正文、代码和文件树的字体可以分别设置；如果试过一圈想从头来，在“排版与字体”页点击“全部恢复默认”。"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"这份示例随时可以关闭。需要再看看时，回到主页，点击 "},{"type":"text","marks":[{"type":"bold"}],"text":"浏览功能示例"},{"type":"text","text":"。"}]}
