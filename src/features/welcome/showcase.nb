@block {"type":"codeBlock","attrs":{"concealed":false,"annotationId":null,"language":"python"},"content":[{"type":"text","text":"def summarize(values):\n    count = len(values)\n    return {\"count\": count, \"mean\": sum(values) / count if count else 0}\n\nprint(summarize([2, 3, 5, 8]))"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"中文输入时，在新行单独输入三个间隔号 "},{"type":"text","marks":[{"type":"code"}],"text":"···"},{"type":"text","text":"，再按 Enter，也能创建代码块；句子里的省略表达不会被转换。"}]}
