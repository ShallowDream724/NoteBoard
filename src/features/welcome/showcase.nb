@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"主页的“更多格式”还可以新建 Draw.io 绘图、PlantUML、Mermaid 和信息图脚本。需要比较两个版本时，可以打开“文本对比”。"}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":2},"content":[{"type":"text","text":"保存、导出，然后分享"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"按 "},{"type":"text","marks":[{"type":"bold"}],"text":"Ctrl+O"},{"type":"text","text":" 打开文件或文件夹，也可以直接粘贴路径。刷新目录时，已经展开的文件夹会保持展开。"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"按 "},{"type":"text","marks":[{"type":"bold"}],"text":"Ctrl+P"},{"type":"text","text":" 进入 PDF 排版预览，调整纸张、页边距、字号和页码。导出完成后，PDF 会在新标签页打开，原来的工作目录保持不变。"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"导出会包含此刻尚未保存的修改，不必先保存，也不会替你保存原文件。页面配置会记住上次选择。"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"在导出窗口切换为 HTML，可以保留轮播、折叠和公式，用默认浏览器打开或定位文件后分享。Word 与 LaTeX 转换需要本机 Pandoc，可在设置的“导出”页查看或指定路径。"}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":3},"content":[{"type":"text","text":"几个顺手的快捷键"}]}
@block {"type":"table","attrs":{"annotationId":null,"tableAlign":"right"}}
