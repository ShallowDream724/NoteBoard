#!noteboard 1
@block {"type":"annotationStore"}
@child {"type":"annotationBody","attrs":{"id":"showcase-welcome"},"content":[{"type":"paragraph","content":[{"type":"text","text":"补充说明可以记录背景、出处或批注，和对应的内容一起保存。"}]},{"type":"paragraph","content":[{"type":"text","text":"选中文字后，工具栏的“添加说明”可以新增一条；图片、公式和代码块也能附加说明。"}]}]}
@child {"type":"annotationBody","attrs":{"id":"showcase-observation"},"content":[{"type":"paragraph","content":[{"type":"text","text":"同一处景色，也有不同的光线与情绪。晨光记轮廓，林间记发现，暮色回看一天的变化。"}]},{"type":"paragraph","content":[{"type":"text","text":"点击图钉固定这份说明，再拖动浮窗顶部调整位置。你可以改写正文、添加列表或图片；说明随文档一起保存。"}]}]}
@child {"type":"annotationBody","attrs":{"id":"showcase-code"},"content":[{"type":"paragraph","content":[{"type":"text","text":"这段函数统计数量与平均值；空列表返回 0，避免除以零。说明可以附在整个代码块上，把用途、边界或待改进之处留在代码旁边。"}]}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":1},"content":[{"type":"text","text":"欢迎使用 NoteBoard"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"把想法写下来，把关系画出来。"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"这是一份可以直接编辑的功能示例。文字、图片和公式都能调整，按 "},{"type":"text","text":"Ctrl+S","marks":[{"type":"bold"}]},{"type":"text","text":" 可以保存为自己的笔记。"}]}
@block {"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"添加与整理："},{"type":"text","text":"空行左侧的 + 可以插入表格、图片、公式等内容；段落左侧的六点把手可以拖动整块。"}]}
@block {"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"键盘操作："},{"type":"text","text":"空行输入 / 可以按名称找功能，例如 /note 提示块、/table 表格和 /fold 折叠块。↑ / ↓ 选择，Enter 插入。"}]}
@block {"type":"githubAlert","attrs":{"concealed":false,"annotationId":"showcase-welcome","kind":"note"},"content":[{"type":"paragraph","content":[{"type":"text","text":"提示块可以用来放备注、提醒或补充信息。右上角的问号还附了一条说明。"}]}]}
@block {"type":"paragraph"}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"图片与图注"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"从顶部工具栏的图片菜单，可以插入单张图片、四宫格、六宫格、九宫格或图片轮播。下面的四宫格留了一格给你，点击空格即可加入自己的图片。图注也可以直接修改。"}]}
@block {"type":"imageCollection","attrs":{"layout":"grid","columns":2}}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"./assets/morning.png","alt":"晨光中的山峰与湖面"}},{"type":"paragraph","content":[{"type":"text","text":"01 / 晨光 · 在湖边开始记录"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"./assets/forest.png","alt":"绿林环抱的山间湖泊"}},{"type":"paragraph","content":[{"type":"text","text":"02 / 林间 · 留下沿途的发现"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"./assets/evening.png","alt":"夕阳下的群山与飞鸟"}},{"type":"paragraph","content":[{"type":"text","text":"03 / 暮色 · 回看一天的变化"}]}]}
@child {"type":"imageSlot"}
@block {"type":"paragraph","content":[{"type":"text","text":"需要更多对照时，六宫格适合两组各三张图片，九宫格适合一整组观察。把光照、构图或过程放在同一页，更容易看出差异。"}]}
@block {"type":"image","attrs":{"src":"./assets/evening.png","alt":"夕阳下的群山与飞鸟","width":"50%","align":"center","caption":"暮色里的群山，一天的观察在这里收尾。"}}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"轮播，让故事一张张展开"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"点击下方的左右箭头或圆点，依次查看晨光、林间和暮色。轮播适合步骤演示、旅行记录和作品展示。"}]}
@block {"type":"imageCollection","attrs":{"layout":"carousel","columns":2}}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"./assets/morning.png","alt":"旅程第一幕：晨光山湖"}},{"type":"paragraph","content":[{"type":"text","text":"第一幕 / 出发，记下最初的印象"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"./assets/forest.png","alt":"旅程第二幕：林间湖泊"}},{"type":"paragraph","content":[{"type":"text","text":"第二幕 / 停留，寻找值得细看的变化"}]}]}
@child {"type":"imageSlot","content":[{"type":"image","attrs":{"src":"./assets/evening.png","alt":"旅程第三幕：山间暮色"}},{"type":"paragraph","content":[{"type":"text","text":"第三幕 / 回望，把发现连成自己的故事"}]}]}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"把补充说明留在文字身边"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"点击这段"},{"type":"text","text":"带说明的文字","marks":[{"type":"annotationReference","attrs":{"id":"showcase-observation"}}]},{"type":"text","text":"，再点图钉固定浮窗，拖动顶部即可换位置。选中文字后点“添加说明”，就能留下背景、出处或下一步想法。"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"图片、公式和代码块也能附上说明。长解释跟着正文中的锚点保存，随时可以展开细看。"}]}
@block {"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"展开细节，或者暂时藏起答案"}]}
@block {"type":"paragraph","content":[{"type":"text","text":"点击“旅程记录清单”展开下面的折叠块。收起后，详细内容仍会随文档保留。"}]}
@block {"type":"disclosure","attrs":{"title":"旅程记录清单","open":false},"content":[{"type":"paragraph","content":[{"type":"text","text":"一次简单的记录，可以从这三件事开始："}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"给每张图片写一句简短图注。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"记下当时的时间、天气和观察位置。"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"把不确定的问题留在说明里，下次继续验证。"}]}]}]}]}
@block {"type":"paragraph","content":[{"type":"text","text":"给自己留一个小提示："},{"type":"text","text":"最值得保存的，往往是当时注意到的细节。","marks":[{"type":"conceal"}]},{"type":"text","text":" 把鼠标移到模糊文字上，或用键盘聚焦，就能读到它。"}]}
@block {"type":"heading","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null,"level":2},"content":[{"type":"text","text":"写作，不必来回切换工具"}]}
@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"普通段落、"},{"type":"text","text":"重点","marks":[{"type":"bold"}]},{"type":"text","text":"、"},{"type":"text","text":"强调","marks":[{"type":"italic"}]},{"type":"text","text":"、"},{"type":"text","text":"删改","marks":[{"type":"strike"}]},{"type":"text","text":"、"},{"type":"text","text":"下划线","marks":[{"type":"underline"}]},{"type":"text","text":"，以及值得回看的句子，都能放在同一份文档中。原生文档会保存文字样式、图片布局与补充说明；Markdown 文件也可以在正文与源码之间切换。"}]}
@block {"type":"paragraph","attrs":{"blockBackground":"#eff6ff"},"content":[{"type":"text","text":"浅蓝底色让整段记录更醒目，"},{"type":"text","text":"黄色高亮留下重点","marks":[{"type":"highlight","attrs":{"color":"#fef08a"}}]},{"type":"text","text":"，"},{"type":"text","text":"蓝色文字","marks":[{"type":"textColor","attrs":{"color":"#2563eb"}}]},{"type":"text","text":"与"},{"type":"text","text":"叠加配色","marks":[{"type":"textColor","attrs":{"color":"#9a3412"}},{"type":"highlight","attrs":{"color":"#ffedd5"}}]},{"type":"text","text":"让关键词各有层次。段落底色和文字高亮可以分别调整。"}]}
