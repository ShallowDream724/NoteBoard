@block {"type":"paragraph","attrs":{"textAlign":null,"indent":0,"concealed":false,"annotationId":null},"content":[{"type":"text","text":"按 "},{"type":"text","marks":[{"type":"bold"}],"text":"Ctrl+P"},{"type":"text","text":" 进入 PDF 排版预览，调整纸张、页边距、字号和页码。生成过程中会显示当前阶段；导出完成后，文件会出现在资源管理器里，可以交给系统默认程序打开。"}]}
